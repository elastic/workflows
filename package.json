    "format:check": "prettier --check ."
  },
  "dependencies": {
    "js-yaml": "^4.2.0",
    "semver": "^7.8.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "liquidjs": "^10.27.2",
    "prettier": "3.9.5",
    "yaml": "^2.9.0"
  }
